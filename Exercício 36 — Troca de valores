Algoritmo "Troca_de_Valores"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor    : Gizelle Karine Santos Alcantara
// Descrição    : Solicita dois números inteiros (A e B), realiza a troca de seus valores utilizando uma variável auxiliar e exibe os resultados antes e depois.
// Autor(a)     : Mauricio Antonio De Souza Barretto Filho
// Data atual   : 01/09/2026

Var
   a, b, aux: inteiro

Inicio
   // Entrada de dados
   Escreval("Digite o valor para A: ")
   Leia(a)

   Escreval("Digite o valor para B: ")
   Leia(b)

   // Exibição dos valores originais
   Escreval("")
   Escreval("--- Antes da Troca ---")
   Escreval("A = ", a)
   Escreval("B = ", b)

   // Processamento (Algoritmo de Troca)
   aux <- a
   a <- b
   b <- aux

   // Saída de dados com valores trocados
   Escreval("")
   Escreval("--- Depois da Troca ---")
   Escreval("A = ", a)
   Escreval("B = ", b)

Fimalgoritmo
