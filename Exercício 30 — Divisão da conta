Algoritmo "Divisao_da_Conta"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor    : Gizelle Karine Santos Alcantara
// Descrição    : Calcula o valor que cada pessoa deve pagar dividindo o total da conta pela quantidade de pessoas.
// Autor(a)     : Mauricio Antonio De Souza Barretto Filho
// Data atual   : 01/09/2026
Var
valor_total: real
   quantidade_pessoas: inteiro
   valor_por_pessoa: real

Inicio
// Entrada de dados
   Escreval("Digite o valor total da conta: ")
   Leia(valor_total)

   Escreval("Digite a quantidade de pessoas: ")
   Leia(quantidade_pessoas)

   // Processamento
   valor_por_pessoa <- valor_total / quantidade_pessoas

   // Saída de dados
   Escreval("Cada pessoa deverá pagar: R$ ", valor_por_pessoa:8:2)
   
Fimalgoritmo
