Algoritmo "Sistema_de_Cadastro_e_Media_Escolar"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor    : Gizelle Karine Santos Alcantara
// Descrição    : Cadastra os dados do estudante, disciplina e notas, calcula a média aritmética e exibe o boletim escolar formatado.
// Autor(a)     : Mauricio Antonio De Souza Barretto Filho
// Data atual   : 01/09/2026

Var
   nome_aluno, matricula, nome_disciplina: caractere
   nota1, nota2, nota3, media: real

Inicio
   // Entrada de dados
   Escreval("Digite o nome do estudante: ")
   Leia(nome_aluno)

   Escreval("Digite a matrícula do estudante: ")
   Leia(matricula)

   Escreval("Digite o nome da disciplina: ")
   Leia(nome_disciplina)

   Escreval("Digite a nota da primeira avaliação: ")
   Leia(nota1)

   Escreval("Digite a nota da segunda avaliação: ")
   Leia(nota2)

   Escreval("Digite a nota da terceira avaliação: ")
   Leia(nota3)

   // Processamento
   media <- (nota1 + nota2 + nota3) / 3

   // Saída de dados (Boletim)
   Escreval("")
   Escreval("========== BOLETIM ==========")
   Escreval("")
   Escreval("Aluno: ", nome_aluno)
   Escreval("Matrícula: ", matricula)
   Escreval("Disciplina: ", nome_disciplina)
   Escreval("")
   Escreval("Nota 1: ", nota1:4:1)
   Escreval("Nota 2: ", nota2:4:1)
   Escreval("Nota 3: ", nota3:4:1)
   Escreval("")
   Escreval("Média: ", media:4:1)
   Escreval("")
   Escreval("=============================")

Fimalgoritmo
