Algoritmo "Pagamento_de_Combustivel"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor    : Gizelle Karine Santos Alcantara
// Descrição    : Solicita o preço do litro do combustível e a quantidade abastecida, calcula e exibe o valor total a pagar.
// Autor(a)     : Mauricio Antonio De Souza Barretto Filho
// Data atual   : 01/09/2026

Var
   preco_litro, quantidade_litros, valor_total: real

Inicio
   // Entrada de dados
   Escreval("Digite o preço do litro do combustível (R$): ")
   Leia(preco_litro)

   Escreval("Digite a quantidade de litros abastecidos: ")
   Leia(quantidade_litros)

   // Processamento
   valor_total <- preco_litro * quantidade_litros

   // Saída de dados
   Escreval("Valor total a pagar: R$ ", valor_total:8:2)

Fimalgoritmo
