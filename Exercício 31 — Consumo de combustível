Algoritmo "Consumo_de_Combustivel"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor    : Gizelle Karine Santos Alcantara
// Descrição    : Calcula e exibe o consumo médio de combustível (km/L) a partir da distância percorrida e dos litros consumidos.
// Autor(a)     : Mauricio Antonio De Souza Barretto Filho
// Data atual   : 01/09/2026
Var
distancia, litros, consumo: real
Inicio
// Entrada de dados
   Escreval("Digite a distância percorrida (em km): ")
   Leia(distancia)

   Escreval("Digite a quantidade de combustível consumida (em litros): ")
   Leia(litros)

   // Processamento
   consumo <- distancia / litros

   // Saída de dados
   Escreval("Consumo médio do veículo: ", consumo:8:2, " km/L")
   
Fimalgoritmo
