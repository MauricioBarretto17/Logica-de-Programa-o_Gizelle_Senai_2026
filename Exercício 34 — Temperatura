Algoritmo "Conversao_de_Temperatura"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor    : Gizelle Karine Santos Alcantara
// Descrição    : Solicita uma temperatura em graus Celsius, converte para Fahrenheit e exibe o resultado formatado.
// Autor(a)     : Mauricio Antonio De Souza Barretto Filho
// Data atual   : 01/09/2026

Var
   celsius, fahrenheit: real

Inicio
   // Entrada de dados
   Escreval("Digite a temperatura em Celsius (°C): ")
   Leia(celsius)

   // Processamento
   fahrenheit <- (celsius * 9 / 5) + 32

   // Saída de dados
   Escreval("Temperatura em Fahrenheit: ", fahrenheit:8:2, " °F")

Fimalgoritmo
